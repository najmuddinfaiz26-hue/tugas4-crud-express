<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CRUD Mahasiswa - Express & MySQL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h2 class="mb-4 text-center">Mahasiswa Searcher</h2>

    <!-- Form Input / Edit -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-primary text-white">
        <%= editData ? 'Edit Data Mahasiswa' : 'Tambah Data Mahasiswa' %>
      </div>
      <div class="card-body">
        <form action="<%= editData ? '/update/' + editData.id : '/tambah' %>" method="POST" class="row g-3">
          <div class="col-md-3">
            <label class="form-label">NIM</label>
            <input type="text" name="nim" class="form-control" value="<%= editData ? editData.nim : '' %>" required placeholder="Contoh: 23001001">
          </div>
          <div class="col-md-4">
            <label class="form-label">Nama Lengkap</label>
            <input type="text" name="nama" class="form-control" value="<%= editData ? editData.nama : '' %>" required placeholder="Contoh: Budi Santoso">
          </div>
          <div class="col-md-3">
            <label class="form-label">Jurusan</label>
            <input type="text" name="jurusan" class="form-control" value="<%= editData ? editData.jurusan : '' %>" required placeholder="Contoh: Teknik Informatika">
          </div>
          <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-success w-100">
              <%= editData ? 'Simpan' : 'Tambah' %>
            </button>
            <% if (editData) { %>
              <a href="/" class="btn btn-secondary">Batal</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabel Data -->
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">Daftar Mahasiswa</div>
      <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
          <thead>
            <tr>
              <th>No</th>
              <th>NIM</th>
              <th>Nama</th>
              <th>Jurusan</th>
              <th class="text-center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (data.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center py-3 text-muted">Belum ada data mahasiswa.</td>
              </tr>
            <% } else { %>
              <% data.forEach((mhs, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= mhs.nim %></td>
                  <td><%= mhs.nama %></td>
                  <td><%= mhs.jurusan %></td>
                  <td class="text-center">
                    <a href="/?editId=<%= mhs.id %>" class="btn btn-warning btn-sm">Edit</a>
                    <form action="/hapus/<%= mhs.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin hapus data ini?')">
                      <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>